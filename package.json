{
  "name": "test-base",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "allure run -- playwright test",
    "test:web-desktop": "allure run -- playwright test --project=chromium",
    "test:web-mobile": "allure run -- playwright test --project='Mobile Chrome'",
    "test:mobile": "maestro test tests/maestro --format junit --output allure-results/maestro-junit.xml --test-output-dir test-results/maestro --flatten-debug-output; r=$?; allure generate allure-results; exit $r",
    "test:all": "playwright test; p=$?; maestro test tests/maestro --format junit --output allure-results/maestro-junit.xml --test-output-dir test-results/maestro --flatten-debug-output; m=$?; allure generate allure-results; exit $((p || m))",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:human": "allure run -- playwright test -c playwright.human.config.ts",
    "test:e2e": "allure run -- playwright test tests/playwright/e2e",
    "test:api": "allure run -- playwright test tests/playwright/api",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results",
    "allure:serve": "allure generate allure-results --open",
    "allure:open": "allure open allure-report",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"tests/**/*.{ts,js}\"",
    "build": "tsc",
    "clean": "rm -rf dist allure-results allure-report test-results",
    "install:browsers": "playwright install",
    "install:deps": "playwright install-deps",
    "prepare": "husky",
    "quality:check": "npm run lint && npm run format:check && npm run build",
    "arch": "node scripts/arch/verify.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "allure": "^3.20.0",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
