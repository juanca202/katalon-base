{
  "name": "test-katalon",
  "version": "1.0.0",
  "description": "Proyecto base de pruebas automatizadas con Katalon Studio",
  "scripts": {
    "allure:katalon": "node scripts/katalon/junit-to-allure.mjs && npm run allure:serve",
    "allure:katalon:reset": "npm run clean:results && npm run allure:katalon",
    "allure:generate": "rm -rf allure-report && allure generate allure-results",
    "allure:serve": "rm -rf allure-report && allure generate allure-results --open",
    "allure:open": "allure open allure-report",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "lint": "eslint scripts",
    "lint:fix": "eslint scripts --fix",
    "format": "prettier --write \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\"",
    "clean": "rm -rf allure-results allure-report",
    "clean:results": "rm -rf allure-results allure-report",
    "emulator:start": "bash scripts/emulator/start.sh",
    "emulator:start:play": "AVD_NAME=qa-pixel-35-play ANDROID_IMAGE=google_apis_playstore bash scripts/emulator/start.sh",
    "emulator:stop": "adb emu kill",
    "prepare": "husky",
    "quality:check": "npm run lint && npm run format:check",
    "arch": "node scripts/arch/verify.mjs",
    "ado:test-runs:publish": "node scripts/ado/test-runs/publish.mjs",
    "ado:env:init": "node scripts/ado/env/init.mjs",
    "ado:work-items:get": "node scripts/ado/work-items/get.mjs",
    "ado:work-items:upsert": "node scripts/ado/work-items/upsert.mjs",
    "ado:test-cases:upsert": "node scripts/ado/test-cases/upsert.mjs",
    "ado:test-cases:delete": "node scripts/ado/test-cases/delete.mjs",
    "codenarc": "gradle -p tests/katalon -q codenarc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "allure": "^3.33.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "kiwi-schema": "0.5.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8"
  },
  "lint-staged": {
    "scripts/**/*.mjs": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
