{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "maestro": {
      "type": "stdio",
      "command": "maestro",
      "args": ["mcp", "--no-viewer", "--working-dir=tests/maestro"]
    },
    "ado-bay-jua": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "BayteqDev",
        "--authentication",
        "pat"
      ],
      "env": {
        "PERSONAL_ACCESS_TOKEN": "${ADO_BAY_JUA_PAT}"
      }
    }
  }
}
