{
  "mcpServers": {
    "katalon-studio": {
      "type": "http",
      "url": "http://localhost:33699/mcp/stream"
    },
    "ado-bay-jua": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "BayteqDev",
        "--authentication",
        "pat"
      ],
      "env": {
        "PERSONAL_ACCESS_TOKEN": "${ADO_BAY_JUA_PAT}"
      }
    }
  }
}
