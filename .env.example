# Base URLs for testing
BASE_URL=https://factor.ec/tripot
API_BASE_URL=https://api.example.com

# Test Environment
TEST_ENV=dev
START_LOCAL_SERVER=false

# Test User Credentials (for demo purposes - use secure vault in production)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
# OTP opcional: si se define, la prueba no pide intervención humana (útil en CI)
TEST_OTP=

# Browser Configuration
HEADLESS=true
BROWSER=chromium
TIMEOUT=30000

# Reporting
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report