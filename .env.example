# Variables de entorno del equipo que ejecuta (ADR-007). No se versiona el .env.
# Katalon Studio las lee con un Custom Keyword; las URLs van en los Execution
# Profiles de tests/katalon/Profiles/.

# Credenciales de prueba de Tripot
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# OTP opcional: si se define, las pruebas Human-in-the-Loop no abren el diálogo
TEST_OTP=

# Publicación de resultados en Azure DevOps (ADR-006)
ADO_PAT=
ADO_TEST_PLAN_ID=
